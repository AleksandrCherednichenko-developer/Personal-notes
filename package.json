{
  "name": "my-notes-application",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "pnpm": "11.20.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
